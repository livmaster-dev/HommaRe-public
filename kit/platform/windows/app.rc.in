// The app's own resources on Windows (host/CMakeLists.txt configures this):
// the icon Explorer, the taskbar and the window show, and the version
// Explorer's Properties and Task Manager show. The manifest comes with the
// platform layer (platform/CMakeLists.txt).
@POP_APP_ICON_RESOURCE@

1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@RECOMP_GAME_NAME@"
      VALUE "ProductName", "@RECOMP_APP_NAME@"
      VALUE "ProductVersion", "@POP_RECOMP_VERSION@"
      VALUE "FileVersion", "@POP_RECOMP_VERSION@"
      VALUE "InternalName", "@RECOMP_APP_NAME@"
      VALUE "OriginalFilename", "@RECOMP_APP_NAME@.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
