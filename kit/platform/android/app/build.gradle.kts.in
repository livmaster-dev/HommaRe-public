plugins {
    id("com.android.application")
}

android {
    namespace = "@bundle_id@"
    compileSdk = 36
    buildToolsVersion = "37.0.0"

    defaultConfig {
        applicationId = "@bundle_id@"
        minSdk = 29
        targetSdk = 36
        versionCode = 1
        versionName = "1.0"
        // The ABIs tools/build.py built (--abi): x86_64 for Intel Chromebooks
        // and the emulator, arm64-v8a for phones, tablets and ARM Chromebooks.
        ndk {
            abiFilters += listOf(@abi_filters@)
        }
        resValue("string", "app_name", "@app_name@")
        resValue("string", "game_id", "@id@")
    }

    // With several ABIs, an APK per ABI besides the universal one: a player
    // sideloads the one for their device and saves the other's size.
    splits {
        abi {
            isEnable = @abi_splits@
            reset()
            include(@abi_filters@)
            isUniversalApk = true
        }
    }

    buildFeatures {
        resValues = true
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    packaging {
        jniLibs {
            // tools/build.py stripped the libraries already (the translated
            // games are far too big to strip twice), and the system unpacks
            // them into the app's native library folder at install: that is
            // where the launcher runs innoextract from (libinnoextract.so)
            // and the host finds the other games' modules
            // (host/sdl/main.cpp modules_dir), and it keeps the APK
            // compressed for the download.
            keepDebugSymbols += "**/*.so"
            useLegacyPackaging = true
        }
    }
    sourceSets.named("main") {
        // Use the SDL version fetched by the native build; no copied Java sources.
        java.srcDirs("src/main/java", "@sdl_java_dir@")
        jniLibs.srcDirs("src/main/jniLibs")
    }
}
